Cell[CellGroupData[{

Cell["Induced scalar curvature R in powers of \[Omega]^2", "Chapter",
 CellChangeTimes->{{3.9895752402819915`*^9, 
  3.9895752686854906`*^9}},ExpressionUUID->"2b7400d2-d3cb-4355-b7d2-\
4e8ef450ec7c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coords", "=", 
    RowBox[{"{", 
     RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], "}"}]}], ";"}], 
  " ", 
  RowBox[{"(*", "Coordinates", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Induced", " ", "metric", " ", "on", " ", "the", " ", "brane"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"\[Omega]", "^", "2"}], "*", 
         RowBox[{"\[CapitalLambda]", "[", "r", "]"}], "*", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}], ",", "0", 
       ",", "0", ",", 
       RowBox[{
        RowBox[{"-", "\[Omega]"}], "*", 
        RowBox[{"\[CapitalLambda]", "[", "r", "]"}], "*", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", 
        RowBox[{"B", "[", "r", "]"}]}], ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"-", 
        RowBox[{
         RowBox[{"\[Rho]", "[", "r", "]"}], "^", "2"}]}], ",", "0"}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[Omega]"}], "*", 
        RowBox[{"\[CapitalLambda]", "[", "r", "]"}], "*", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}], ",", "0", ",", 
       "0", ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"\[Rho]", "[", "r", "]"}], "^", "2"}]}], " ", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}], "}"}]}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"asumptions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", ">", "0"}], ",", 
     RowBox[{"0", "<", "\[Theta]", "<", "Pi"}], ",", 
     RowBox[{"\[Omega]", ">=", "0"}], ",", 
     RowBox[{
      RowBox[{"\[CapitalLambda]", "[", "r", "]"}], ">", "0"}], ",", 
     RowBox[{
      RowBox[{"B", "[", "r", "]"}], ">", "0"}], ",", 
     RowBox[{
      RowBox[{"\[Rho]", "[", "r", "]"}], ">", "0"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", 
    RowBox[{"Length", "[", "coords", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Space", "-", 
    RowBox[{"time", " ", "dimensions"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gInv", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Inverse", "[", "g", "]"}], ",", "asumptions"}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Metric", " ", "inverse"}], "*)"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Christoffel", " ", "symbols"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Christoffel", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], "*", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"gInv", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "s"}], "]"}], "]"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "s"}], "]"}], "]"}], ",", 
             RowBox[{"coords", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "+", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", 
               RowBox[{"j", ",", "s"}], "]"}], "]"}], ",", 
             RowBox[{"coords", "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], "]"}], "-", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"[", 
               RowBox[{"j", ",", "k"}], "]"}], "]"}], ",", 
             RowBox[{"coords", "[", 
              RowBox[{"[", "s", "]"}], "]"}]}], "]"}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Christoffel", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"Christoffel", ",", "asumptions"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Riemann", " ", "tensor"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Riemann", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Christoffel", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "m"}], "]"}], "]"}], ",", 
         RowBox[{"coords", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], "]"}], "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Christoffel", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], ",", 
         RowBox[{"coords", "[", 
          RowBox[{"[", "m", "]"}], "]"}]}], "]"}], "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Christoffel", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "k", ",", "s"}], "]"}], "]"}], "*", 
          RowBox[{"Christoffel", "[", 
           RowBox[{"[", 
            RowBox[{"s", ",", "j", ",", "m"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "1", ",", "n"}], "}"}]}], "]"}], "-", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Christoffel", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "m", ",", "s"}], "]"}], "]"}], "*", 
          RowBox[{"Christoffel", "[", 
           RowBox[{"[", 
            RowBox[{"s", ",", "j", ",", "k"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Riemann", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"Riemann", ",", "asumptions"}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"Ricci", " ", "tensor"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RicciTensor", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"Riemann", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j", ",", "i", ",", "m"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
