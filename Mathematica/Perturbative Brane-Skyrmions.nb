   3.9815513589004526`*^9, {3.981551424809124*^9, 3.981551430705459*^9}, {
   3.9815514869092674`*^9, 3.9815514926650977`*^9}, {3.981551661339283*^9, 
   3.9815516618000307`*^9}, 3.981551758378935*^9, {3.981552042054104*^9, 
   3.981552078569603*^9}, {3.9815521127966037`*^9, 3.9815521462968597`*^9}, {
   3.981552336895105*^9, 3.981552351730551*^9}, {3.9815524317779665`*^9, 
   3.981552561374106*^9}, {3.9815528041418023`*^9, 3.981552956780666*^9}, {
   3.9815532356002192`*^9, 3.9815533030266695`*^9}, {3.9815533442893567`*^9, 
