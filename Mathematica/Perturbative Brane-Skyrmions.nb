Cell["\<\
Author: Sergio S\[AAcute]nchez Rentero
Contact: sergis15@ucm.es
Links: https://github.com/sergiosr150703-lang 

Project Context: This code is part of a Master\[CloseCurlyQuote]s Thesis in \
Theoretical Physics. The project investigates the canonical quantization of \
topological solitons in brane-world scenarios. In particular, this notebook \
takes care about the systematic calculation of the quantum Hamiltonian and \
the induced scalar curvature through a perturbative approach.

Last Updated: June 2026\
\>", "Text",
 CellChangeTimes->{{3.9895742687806244`*^9, 3.98957441009564*^9}, {
  3.9895744405528817`*^9, 
  3.9895745575624294`*^9}},ExpressionUUID->"50027a80-0a93-4aa6-8fac-\
ee1e21cb74aa"],

Cell[CellGroupData[{

Cell["Quantum Hamiltonian of Brane-Skyrmions in powers of J^2", "Chapter",
 CellChangeTimes->{{3.989574573673278*^9, 3.9895746042757225`*^9}, {
  3.989575271858996*^9, 
  3.9895752771869893`*^9}},ExpressionUUID->"5c8a33af-db56-46da-b104-\
44397bdb1638"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nMax", "=", "5"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Maximum", " ", "power", " ", "of", " ", 
    RowBox[{"J", "^", "2"}], "n"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lagrangian", "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"c", "[", 
       RowBox[{"2", " ", "k"}], "]"}], "*", 
      RowBox[{"\[Omega]", "^", 
       RowBox[{"(", 
        RowBox[{"2", " ", "k"}], ")"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "nMax"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"(*", 
   RowBox[{"Lagrangian", " ", "in", " ", "powers", " ", "of", " ", 
    RowBox[{"\[Omega]", "^", "2"}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Coefficients", " ", "of", " ", "the", " ", "series"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"c", "[", "0", "]"}], "=", 
   RowBox[{"-", "\[Alpha]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c", "[", "2", "]"}], "=", "\[Beta]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c", "[", "4", "]"}], "=", "\[Gamma]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c", "[", "6", "]"}], "=", "\[Delta]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c", "[", "8", "]"}], "=", "\[Zeta]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"c", "[", "10", "]"}], "=", "\[Eta]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Series", " ", "inversion"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"seriesY", "=", 
   RowBox[{"D", "[", 
    RowBox[{"Lagrangian", ",", "\[Omega]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"orderY", "=", 
   RowBox[{
    RowBox[{"2", " ", "nMax"}], "-", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"seriesX", "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"A", "[", "i", "]"}], "*", 
      RowBox[{"J", "^", "i"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "orderY", ",", "2"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"composition", "=", 
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"seriesY", "/.", " ", 
       RowBox[{"\[Omega]", "->", "seriesX"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"J", ",", "0", ",", "orderY"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"eqs", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"composition", ",", "J", ",", "i"}], "]"}], "==", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"i", "==", "1"}], ",", "1", ",", "0"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "orderY", ",", "2"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"variables", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"A", "[", "i", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "orderY", ",", "2"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solutions", "=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{"eqs", ",", "variables"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xDeY", "=", 
    RowBox[{"seriesX", "/.", " ", "solutions"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Hamiltonian", " ", "calculation"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Hamiltonian", "=", 
    RowBox[{
     RowBox[{"\[Omega]", "*", "J"}], "-", "Lagrangian"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Print", " ", "of", " ", "the", " ", "result"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Hy", "=", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{"Series", "[", 
       RowBox[{
        RowBox[{"Hamiltonian", "/.", " ", 
         RowBox[{"\[Omega]", "->", "xDeY"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"J", ",", "0", ",", 
          RowBox[{"2", " ", "nMax"}]}], "}"}]}], "]"}], "]"}], ",", "J", ",", 
     "FullSimplify"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Style", "[", 
    RowBox[{"Hy", ",", "Bold", ",", "Blue", ",", "14"}], "]"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", "\"\<-------------------------------------------------\>\"", 
    "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"Coefficients", " ", "extraction"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"coef", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Coefficient", "[", 
       RowBox[{
        RowBox[{"Expand", "[", "Hy", "]"}], ",", "J", ",", 
        RowBox[{"2", " ", "k"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Order J^\>\"", ",", 
      RowBox[{"2", " ", "k"}], ",", "\"\< : \>\"", ",", 
      RowBox[{"Style", "[", 
       RowBox[{"coef", ",", "Bold", ",", 
        RowBox[{"Darker", "[", "Green", "]"}]}], "]"}]}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "0", ",", "nMax"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9815495056428556`*^9, 3.9815495056448617`*^9}, {
