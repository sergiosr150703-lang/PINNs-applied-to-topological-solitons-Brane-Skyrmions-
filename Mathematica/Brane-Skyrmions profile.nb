Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "s", ",", "r", ",", "x", ",", "G", ",", "\[Beta]", ",", "\[Lambda]"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lam", "=", 
    RowBox[{"1", "/", "10"}]}], ";"}], " ", 
  RowBox[{"(*", "Coupling", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rMin", "=", 
    RowBox[{"10", "^", 
     RowBox[{"-", "5"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Lowest", " ", "integration", " ", "limit"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rMax", "=", "25"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Highest", " ", "integration"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"We", " ", "define", " ", "a", " ", "logarithmic", " ", "grid"}], 
   "*)"}]}], "\n", 
 RowBox[{
