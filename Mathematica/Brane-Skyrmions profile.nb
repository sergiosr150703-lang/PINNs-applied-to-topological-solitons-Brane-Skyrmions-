  RowBox[{
   RowBox[{"xMax", "=", 
    RowBox[{"Log", "[", "rMax", "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Equation", " ", "of", " ", "motion"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Shoot", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"IsolatedSol", "/.", " ", 
       RowBox[{"\[Lambda]", "->", "lam"}]}], "/.", " ", 
      RowBox[{"\[Beta]", "->", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Logarithmic", " ", "variable", " ", "change"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ShootX", "=", 
    RowBox[{"Shoot", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", "->", 
        RowBox[{"Exp", "[", "x", "]"}]}], ",", 
       RowBox[{
        RowBox[{"F", "[", "r", "]"}], "->", 
        RowBox[{"G", "[", "x", "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"F", "'"}], "[", "r", "]"}], "->", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"-", "x"}], "]"}], "*", 
         RowBox[{
          RowBox[{"G", "'"}], "[", "x", "]"}]}]}]}], "}"}]}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"New", " ", "equation", " ", 
     RowBox[{"F", "''"}]}], "=", 
