      RowBox[{
       RowBox[{"G", "'"}], "[", "x", "]"}], "+", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"2", "x"}], "]"}], "*", "ShootX"}]}]}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
