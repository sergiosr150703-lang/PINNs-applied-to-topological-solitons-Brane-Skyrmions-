      RowBox[{
       RowBox[{"G", "''"}], "-", 
       RowBox[{"G", "'"}]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"ShootX", "==", ">", 
      RowBox[{"G", "''"}]}], "=", 
     RowBox[{
      RowBox[{"G", "'"}], "+", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"2", "x"}], "]"}], "*", "ShootX"}]}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EqLog", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"G", "''"}], "[", "x", "]"}], "==", 
