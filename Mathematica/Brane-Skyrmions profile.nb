Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Undo", " ", "the", " ", "logarithmic", " ", "change"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"FShoot", "[", "r_", "]"}], ":=", 
     RowBox[{"FinalProfile", "[", 
      RowBox[{"Log", "[", "r", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Energy", " ", "calculation", " ", "with", " ", "variable", " ", "r"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EnergyDensity", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"L", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Lambda]", "->", "lam"}], ",", 
          RowBox[{"\[Beta]", "->", "1"}]}], "}"}]}], ")"}], "-", 
      RowBox[{"r", "^", "2"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Integrand", "[", "r_", "]"}], ":=", 
     RowBox[{"EnergyDensity", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"F", "[", "r", "]"}], "->", 
         RowBox[{"FShoot", "[", "r", "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"F", "'"}], "[", "r", "]"}], "->", 
         RowBox[{
          RowBox[{"FShoot", "'"}], "[", "r", "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"F", "''"}], "[", "r", "]"}], "->", 
         RowBox[{
          RowBox[{"FShoot", "''"}], "[", "r", "]"}]}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TotalEnergy", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", "*", 
        RowBox[{"Pi", "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", 
           RowBox[{"Pi", "^", "2"}]}], ")"}]}]}], ")"}], "*", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"Integrand", "[", "r", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "rMin", ",", "rMax"}], "}"}], ",", 
        RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}]}], "]"}]}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<E = \>\"", ",", "TotalEnergy"}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9837928993693843`*^9, 3.9837929309335423`*^9}, 
   3.9852407036619606`*^9, 3.9852407953010283`*^9, 3.9852410730575027`*^9, 
   3.9852415285527735`*^9, 3.985241945940174*^9, {3.9852425467482977`*^9, 
   3.9852426334365478`*^9}, {3.9895784067276993`*^9, 3.9895784812481146`*^9}},
