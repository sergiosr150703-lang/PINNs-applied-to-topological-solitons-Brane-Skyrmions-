Cell[CellGroupData[{

Cell["Cross Check del Shooting Method", "Chapter",
 CellChangeTimes->{{3.9761056514275007`*^9, 3.9761056662606153`*^9}, {
   3.9761057876847057`*^9, 3.9761057885750866`*^9}, {3.976105834357713*^9, 
   3.9761058563328657`*^9}, 3.976105934809901*^9, {3.976106013166224*^9, 
   3.9761060326956635`*^9}, 
   3.976106425412007*^9},ExpressionUUID->"43cdc382-e76c-4fdd-a88f-\
43a3d709a219"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "This", " ", "part", " ", "is", " ", "to", " ", "check", " ", "that", " ",
      "the", " ", "Shooting", " ", "method", " ", "of", " ", "above", " ", 
     "can", " ", "solve", " ", "the", " ", "known", " ", "profile", " ", "of",
      " ", "classical", " ", 
     RowBox[{"Skyrmions", ".", " ", "See"}], " ", "Fig", " ", "9.1", " ", 
     "of", " ", "Topological", " ", "solitons"}], ",", " ", 
    RowBox[{
     RowBox[{"N", ".", "S", ".", "Manton"}], " ", "and", " ", 
     RowBox[{"P", ".", "Sutcliffe", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"s", ",", "r"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Skyrmion", " ", "equation", " ", "of", " ", "motion"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EoM", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"r", "^", "2"}], "+", 
          RowBox[{"2", "*", 
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{"f", "[", "r", "]"}], "]"}], "^", "2"}]}]}], ")"}], "*", 
        RowBox[{
         RowBox[{"f", "''"}], "[", "r", "]"}]}], "+", 
       RowBox[{"2", "*", "r", "*", 
        RowBox[{
         RowBox[{"f", "'"}], "[", "r", "]"}]}], "+", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"2", "*", 
          RowBox[{"f", "[", "r", "]"}]}], "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"f", "'"}], "[", "r", "]"}], "^", "2"}], "-", "1", "-", 
          RowBox[{
           RowBox[{
            RowBox[{"Sin", "[", 
             RowBox[{"f", "[", "r", "]"}], "]"}], "^", "2"}], "/", 
           RowBox[{"r", "^", "2"}]}]}], ")"}]}]}], "==", "0"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rMin", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "4"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rMax", "=", "20"}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ParametricSol", "=", 
     RowBox[{"ParametricNDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"EoM", ",", 
         RowBox[{
          RowBox[{"f", "[", "rMin", "]"}], "==", 
          RowBox[{"Pi", "-", 
           RowBox[{"s", "*", "rMin"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"f", "'"}], "[", "rMin", "]"}], "==", 
          RowBox[{"-", "s"}]}]}], "}"}], ",", "f", ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "rMin", ",", "rMax"}], "}"}], ",", 
       RowBox[{"{", "s", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Optimal", " ", "slope", " ", "search"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ParametricSol", "[", "s", "]"}], "[", "rMax", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "0.5", ",", "5"}], "}"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Slope s\>\"", ",", "\"\<f(rMax)\>\""}], "}"}]}], ",", " ", 
     RowBox[{
     "PlotLabel", "->", "\"\<Visual search of the optimal slope\>\""}]}], 
    "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Sol", "=", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ParametricSol", "[", "s", "]"}], "[", "rMax", "]"}], "==", 
        "0"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"s", ",", "2.0"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Slope", "=", 
     RowBox[{"s", "/.", " ", "Sol"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Initial slope found: s = \>\"", ",", "Slope"}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Final", " ", "plot"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FinalProfile", "=", 
     RowBox[{"ParametricSol", "[", "Slope", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"FinalProfile", "[", "r", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "rMin", ",", "rMax"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<r\>\"", ",", "12", ",", "Italic", ",", "Black"}], "]"}],
         ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<f(r)\>\"", ",", "12", ",", "Italic", ",", "Black"}], 
         "]"}]}], "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Style", "[", 
       RowBox[{
       "\"\<Skyrmion Profile (Shooting Method)\>\"", ",", "14", ",", 
        "Black"}], "]"}]}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "Medium", "]"}], ",", "Red", ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"0", ",", "Pi"}], "}"}], "]"}], ",", 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<f(0)=\[Pi]\>\"", ",", "12", ",", "Red"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}]}], "]"}], ",", "Red", ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"rMax", ",", "0"}], "}"}], "]"}], ",", 
        RowBox[{"Inset", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<f(\[Infinity])=0\>\"", ",", "12", ",", "Red"}], "]"}],
           ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rMax", "-", "2"}], ",", "0.3"}], "}"}]}], "]"}]}], 
       "}"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9761056514275007`*^9, 3.9761056662606153`*^9}, {
   3.9761057876847057`*^9, 3.9761057885750866`*^9}, {3.976105834357713*^9, 
