Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"(*", 
   RowBox[{"Exact", " ", "calculation", " ", "of", " ", "s"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Sol", "=", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ParametricSol", "[", "s", "]"}], "[", "xMax", "]"}], "==", 
        "0"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "44", ",", "45"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "30"}], ",", 
       RowBox[{"AccuracyGoal", "->", "10"}], ",", 
       RowBox[{"PrecisionGoal", "->", "10"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Slope", "=", 
     RowBox[{"s", "/.", " ", "Sol"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Initial slope found: s = \>\"", ",", "Slope"}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FinalProfile", "=", 
     RowBox[{"ParametricSol", "[", "Slope", "]"}]}], ";", " ", 
    RowBox[{"(*", 
     RowBox[{"Final", " ", "profile"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"Manton", "[", "r_", "]"}], "=", 
     RowBox[{"Pi", "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"r", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"r", "^", "2"}], "+", 
           RowBox[{
            RowBox[{"(", "0.23", ")"}], "^", "2"}]}], "]"}]}]}], ")"}]}]}], 
    ";", " ", 
    RowBox[{"(*", 
     RowBox[{"Atiyah", "-", 
      RowBox[{"Manton", " ", "profile"}]}], "*)"}], "\[IndentingNewLine]", 
    "\n", 
